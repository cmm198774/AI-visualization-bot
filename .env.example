# ==========================================
# LLM 模型配置（阿里云 Token Plan）
# ==========================================
LLM_API_KEY=your-llm-api-key
LLM_MODEL_NAME=qwen3.6-flash
LLM_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_TEMPERATURE=0.2

# ==========================================
# DashScope（Embedding 模型）
# ==========================================
DASHSCOPE_API_KEY=your-dashscope-api-key
EMBEDDING_MODEL=text-embedding-v3

# ==========================================
# Qdrant 向量数据库
# ==========================================
QDRANT_COLLECTION=lisa_knowledge

# ==========================================
# Redis 配置
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379

# ==========================================
# 服务配置
# ==========================================
SERVER_PORT=8000

# ==========================================
# 内存与上下文配置
# ==========================================
MEMORY_TOKEN_LIMIT=20000
MAX_CHECKPOINTS=5

# ==========================================
# 认证配置
# ==========================================
SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==========================================
# TTS 服务配置
# ==========================================
TTS_SERVER_URL=http://127.0.0.1:9233/tts
TTS_SPEAKER=中文女
TTS_TIMEOUT=10
